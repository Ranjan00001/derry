{
  "open_terminal": ["gnome-terminal"],
  "lock_screen": ["xdg-screensaver", "lock"],
  "check_battery": ["upower", "-i", "/org/freedesktop/UPower/devices/battery_BAT0"],
  "open_browser": ["xdg-open", "http://google.com"],
  "system_info": ["uname", "-a"],
  "free_memory": ["free", "-m"],
  "disk_space": ["df", "-h"],
  "list_files": ["ls", "-la"],
  "current_directory": ["pwd"],
  "network_status": ["nmcli", "connection", "show"],
  "ping_google": ["ping", "-c", "4", "google.com"],
  "cpu_info": ["lscpu"],
  "uptime": ["uptime"],
  "whoami": ["whoami"],
  "date_time": ["date"],
  "open_calculator": ["gnome-calculator"],
  "open_settings": ["gnome-control-center"],
  "open_file_manager": ["xdg-open", "."],
  "volume_up": ["amixer", "-q", "sset", "Master", "5%+"],
  "volume_down": ["amixer", "-q", "sset", "Master", "5%-"],
  "volume_mute": ["amixer", "-q", "sset", "Master", "toggle"],
  "suspend_system": ["systemctl", "suspend"],
  "bluetooth_status": ["bluetoothctl", "show"],
  "list_usb": ["lsusb"]
}
